# FlashQ - Environment Variables Template
# Copy this file to `.env` in the root of your project and populate with your Firebase credentials.
# In Expo SDK 49+, environment variables prefixed with `EXPO_PUBLIC_` are automatically exposed in JavaScript.

# Firebase Web App Credentials (from Firebase Console -> Project Settings -> General -> Your apps)
EXPO_PUBLIC_FIREBASE_API_KEY=AIzaSyYourFirebaseApiKeyHere
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-firebase-app.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-firebase-app
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-firebase-app.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
EXPO_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890
